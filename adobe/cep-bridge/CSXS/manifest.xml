<?xml version="1.0" encoding="UTF-8"?>
<!-- WhyNot Cut 3.0.0 (3.0 T6.3 Task 4). The ids stay ai.thewhynot.cut.bridge(.panel/.daemon): a new id would leave the
     3.1.1 bundle loaded beside this one. Only the visible names say "WhyNot Cut". -->
<ExtensionManifest Version="7.0" ExtensionBundleId="ai.thewhynot.cut.bridge" ExtensionBundleVersion="3.0.0"
                   ExtensionBundleName="WhyNot Cut" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="ai.thewhynot.cut.bridge.panel" Version="3.0.0"/>
    <Extension Id="ai.thewhynot.cut.bridge.daemon" Version="3.0.0"/>
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="PPRO" Version="[22.0,99.9]"/>
      <Host Name="AEFT" Version="[24.0,99.9]"/>
    </HostList>
    <LocaleList><Locale Code="All"/></LocaleList>
    <RequiredRuntimeList><RequiredRuntime Name="CSXS" Version="11.0"/></RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <!-- the visible panel: After Effects only (Premiere has the UXP panel). It shows the daemon's state and never works
         the job queue -->
    <Extension Id="ai.thewhynot.cut.bridge.panel">
      <HostList>
        <Host Name="AEFT" Version="[24.0,99.9]"/>
      </HostList>
      <DispatchInfo Host="AEFT">
        <Resources>
          <MainPath>./ui/index.html</MainPath>
          <ScriptPath>./jsx/wnc_host.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle><AutoVisible>true</AutoVisible></Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>WhyNot Cut</Menu>
          <Geometry>
            <Size><Height>640</Height><Width>340</Width></Size>
            <MinSize><Height>320</Height><Width>280</Width></MinSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
    <!-- the hidden daemon, in Premiere and After Effects: loads by itself when the app starts or activates, no menu
         click needed; the only copy that works the job queue (js/bridge.js) -->
    <Extension Id="ai.thewhynot.cut.bridge.daemon">
      <DispatchInfo>
        <Resources>
          <MainPath>./daemon.html</MainPath>
          <ScriptPath>./jsx/wnc_host.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>false</AutoVisible>
          <StartOn>
            <Event>com.adobe.csxs.events.ApplicationActivate</Event>
            <Event>applicationActivate</Event>
          </StartOn>
        </Lifecycle>
        <UI><Type>Custom</Type><Geometry><Size><Height>1</Height><Width>1</Width></Size></Geometry></UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
