{
  "manifestVersion": 5,
  "id": "ai.thewhynot.cut.dev",
  "name": "WhyNot Cut",
  "version": "3.0.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "26.5.0"
  },
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "network": {
      "domains": [
        "ws://127.0.0.1",
        "http://127.0.0.1"
      ]
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "whynotCut",
      "label": {
        "default": "WhyNot Cut"
      },
      "minimumSize": {
        "width": 280,
        "height": 320
      },
      "preferredDockedSize": {
        "width": 340,
        "height": 640
      },
      "preferredFloatingSize": {
        "width": 340,
        "height": 640
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/dark/icon-23.png",
          "scale": [
            1,
            2
          ],
          "theme": [
            "darkest",
            "dark",
            "medium"
          ],
          "species": [
            "chrome"
          ]
        },
        {
          "width": 23,
          "height": 23,
          "path": "icons/light/icon-23.png",
          "scale": [
            1,
            2
          ],
          "theme": [
            "light",
            "lightest"
          ],
          "species": [
            "chrome"
          ]
        }
      ]
    }
  ],
  "icons": [
    {
      "width": 24,
      "height": 24,
      "path": "icons/dark/icon-24.png",
      "scale": [
        1,
        2
      ],
      "theme": [
        "darkest",
        "dark",
        "medium"
      ],
      "species": [
        "pluginList"
      ]
    },
    {
      "width": 24,
      "height": 24,
      "path": "icons/light/icon-24.png",
      "scale": [
        1,
        2
      ],
      "theme": [
        "light",
        "lightest"
      ],
      "species": [
        "pluginList"
      ]
    }
  ]
}
