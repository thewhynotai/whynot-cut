{
  "manifestVersion": 5,
  "id": "ai.thewhynot.cut.spike",
  "name": "WhyNot Cut Spike",
  "version": "0.1.6",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "26.5.0"
  },
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "clipboard": "readAndWrite",
    "launchProcess": {
      "schemes": ["file", "whynotcut"],
      "extensions": [".mp4", ".mov", ".prproj", ""]
    },
    "network": {
      "domains": [
        "ws://127.0.0.1:*",
        "ws://localhost:*",
        "http://127.0.0.1:*",
        "http://localhost:*",
        "ws://127.0.0.1",
        "ws://localhost",
        "http://127.0.0.1",
        "http://localhost"
      ]
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "whynotCutSpike",
      "label": { "default": "WhyNot Cut Spike" },
      "minimumSize": { "width": 280, "height": 320 },
      "preferredDockedSize": { "width": 340, "height": 640 },
      "preferredFloatingSize": { "width": 340, "height": 640 },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/dark/icon-23.png",
          "scale": [1, 2],
          "theme": ["darkest", "dark", "medium"],
          "species": ["chrome"]
        },
        {
          "width": 23,
          "height": 23,
          "path": "icons/light/icon-23.png",
          "scale": [1, 2],
          "theme": ["light", "lightest"],
          "species": ["chrome"]
        }
      ]
    }
  ],
  "icons": [
    {
      "width": 24,
      "height": 24,
      "path": "icons/dark/icon-24.png",
      "scale": [1, 2],
      "theme": ["darkest", "dark", "medium"],
      "species": ["pluginList"]
    },
    {
      "width": 24,
      "height": 24,
      "path": "icons/light/icon-24.png",
      "scale": [1, 2],
      "theme": ["light", "lightest"],
      "species": ["pluginList"]
    }
  ]
}
