{
  "name": "whynot-cut-adobe",
  "private": true,
  "version": "0.0.0",
  "description": "WhyNot Cut Adobe workspace: Premiere UXP plugin, UXP spike, shared panel UI.",
  "workspaces": [
    "panel-ui",
    "premiere-uxp"
  ],
  "scripts": {
    "check": "npm run check --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "package:spike": "npm run package:spike -w premiere-uxp",
    "package": "npm run package -w premiere-uxp",
    "package:plugin": "npm run package:plugin -w premiere-uxp",
    "build:plugin": "npm run build:plugin -w premiere-uxp",
    "dev-install": "node premiere-uxp/scripts/dev-install.mjs"
  }
}
