+class TestLicence(unittest.TestCase):
+    """Task 18 (BL-02): the plugin is GPL-3.0-or-later, and the release zip carries the licence and the notices."""
+
+    def test_plugin_licence_is_gpl3_or_later(self):
+        import json
+        self.assertEqual(json.loads((SK / ".claude-plugin" / "plugin.json").read_text(encoding="utf-8"))["license"],
+                         "GPL-3.0-or-later")
+        self.assertEqual((SK / "LICENSE").read_bytes(), (REPO / "LICENSE").read_bytes())
+
+    def test_the_zip_ships_the_licence_and_the_notices(self):
+        spec = importlib.util.spec_from_file_location("wnc_package_licence", REPO / "package.py")
+        pkg = importlib.util.module_from_spec(spec)
+        spec.loader.exec_module(pkg)
+        names = {p.relative_to(REPO).as_posix() for p in pkg.package_files(REPO)}
+        self.assertLessEqual({"LICENSE", "THIRD-PARTY-NOTICES.md", "whynot-cut/LICENSE"}, names)
+
