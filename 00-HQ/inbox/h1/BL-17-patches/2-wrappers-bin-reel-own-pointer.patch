+if not "%WNC_C%"=="cache" goto :install_id_done
+if not "%WNC_P%"=="plugins" goto :install_id_done
+if not defined WNC_M goto :install_id_done
+if not "%WNC_M:~80%"=="" goto :install_id_done
+for %%c in (. - _) do if "%WNC_M:~0,1%"=="%%c" goto :install_id_done
+for /f "eol=| delims=ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._-" %%x in ("x%WNC_M%") do goto :install_id_done
+set "WNC_ID=%WNC_M%"
