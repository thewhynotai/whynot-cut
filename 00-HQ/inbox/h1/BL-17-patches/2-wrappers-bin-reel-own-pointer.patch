diff --git a/whynot-cut/bin/reel b/whynot-cut/bin/reel
index 2bb8fcc..4b18fe1 100755
--- a/whynot-cut/bin/reel
+++ b/whynot-cut/bin/reel
@@ -45,9 +45,20 @@ settings_engine_home() {   # $1 = settings.json, one key per line as Claude Code
   if [ -n "$seen_id" ]; then json_path "$val_id"; elif [ -n "$seen_any" ]; then json_path "$val_any"; fi
   return 0
 }
+install_id() {   # plat.install_id() on this plugin folder: <...>/plugins/cache/<marketplace>/<plugin>/<version> ->
+  # <marketplace>, anything else -> inline
+  local up="${HERE%/*}" id_re='^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$'
+  up="${up%/*}"
+  INSTALL_ID=inline
+  if [[ ${up%/*} == */plugins/cache ]] && [[ ${up##*/} =~ $id_re ]]; then INSTALL_ID="${up##*/}"; fi
+}
 HOME_DIR="${WHYNOT_HOME:-${CLAUDE_PLUGIN_OPTION_ENGINE_HOME:-${REEL_HOME:-${CLAUDE_PLUGIN_OPTION_REEL_HOME:-}}}}"
 if [ -z "$HOME_DIR" ]; then
-  if ! pointer_engine_home "${WHYNOT_OPTIONS_FILE:-$HOME/.whynot-cut/plugin-options.json}"; then
+  # this install's own pointer first (BL-17, plat.install_options_file; never with WHYNOT_OPTIONS_FILE), then the
+  # shared one (earlier releases and the installer write it)
+  install_id
+  if ! { [ -z "${WHYNOT_OPTIONS_FILE:-}" ] && pointer_engine_home "$HOME/.whynot-cut/plugin-options.$INSTALL_ID.json"; } &&
+     ! pointer_engine_home "${WHYNOT_OPTIONS_FILE:-$HOME/.whynot-cut/plugin-options.json}"; then
     settings_engine_home "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/settings.json"
   fi
   case "$HOME_DIR" in "~"|"~/"*|"~\\"*) HOME_DIR="$HOME${HOME_DIR:1}" ;; esac
diff --git a/whynot-cut/bin/reel.cmd b/whynot-cut/bin/reel.cmd
index b6b9686..bd4386d 100644
--- a/whynot-cut/bin/reel.cmd
+++ b/whynot-cut/bin/reel.cmd
@@ -127,18 +127,29 @@ exit /b 0
 :saved_home
 rem engine_home from the pointer file when it is valid (an "engine_home" string line and the closing brace; "" = not
 rem set), else from settings.json. Both are read as JSON with one key per line, as UTF-8 (chcp 65001, put back after)
-rem so an Arabic path survives.
+rem so an Arabic path survives. This install's own pointer first (BL-17, plat.install_options_file; never with
