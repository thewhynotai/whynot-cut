+
+:install_id
+rem WNC_OWN = this install's own pointer: plat.install_id() on this plugin folder, <...>\plugins\cache\<marketplace>\
+rem <plugin>\<version> gives <marketplace> ([A-Za-z0-9] then up to 79 of [A-Za-z0-9._-]), anything else "inline"
+rem (%WNC_M:x% is expanded when its line is read: those lines are reached only once WNC_M is defined)
+set "WNC_ID=inline"
+set "WNC_M=" & set "WNC_C=" & set "WNC_P="
+for %%i in ("%WNC_HERE%\..\..") do set "WNC_M=%%~nxi"
+for %%i in ("%WNC_HERE%\..\..\..") do set "WNC_C=%%~nxi"
