+)
+if defined WNC_GOT_ID if defined WNC_CLOSED goto :saved_pick
+call :scan_reset
 if exist "%WNC_PTR%" (
   set "WNC_SRC=%WNC_PTR%"
   set "WNC_IN_ID=1"
@@ -162,7 +173,28 @@ if "%WNC_VAL:~0,1%"=="~" set "WNC_VAL=%USERPROFILE%%WNC_VAL:~1%"
 set "WNC_HOME=%WNC_VAL%"
 :saved_done
 call :scan_reset
-set "WNC_PTR=" & set "WNC_CFG=" & set "WNC_OLDCP=" & set "WNC_VAL="
+set "WNC_PTR=" & set "WNC_CFG=" & set "WNC_OLDCP=" & set "WNC_VAL=" & set "WNC_OWN="
