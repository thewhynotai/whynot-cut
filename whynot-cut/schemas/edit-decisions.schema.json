{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:whynot-cut:schema:edit-decisions:1",
  "title": "01_analysis/edit-decisions.json (authored by the story-editor, compiled by `reel plan`)",
  "description": "The shape `reel plan` reads (3.0 T2.3). Structure only: `reel plan` still checks the meaning (evidence verbatim in the transcript, times inside the clip, templates of the profile, images in the asset manifest). Times are seconds (12.5), an integer of milliseconds, or a clock (00:00:12.500). Extra fields (notes, rationale) are allowed. Check with `reel validate <file>`.",
  "type": "object",
  "required": ["decisions"],
  "properties": {
    "schema_version": {"const": 1, "description": "the version of this schema the file follows"},
    "video_id": {"type": "string"},
    "version": {"type": "integer"},
    "global": {
      "type": "object",
      "properties": {
        "main_footage": {"type": ["string", "null"], "minLength": 1,
                         "description": "the raw file, relative to the client folder; a podcast reel (source range) may leave it out"},
        "base_scale_percent": {"type": ["number", "string", "null"], "pattern": "^auto$"},
        "base_offset_x": {"type": ["number", "null"]},
        "base_offset_y": {"type": ["number", "null"]},
        "framing": {"type": ["string", "null"], "pattern": "^ *(full|[0-9]+(\\.[0-9]+)? *[:xX] *[0-9]+(\\.[0-9]+)?)? *$",
                    "description": "9:16 (default) or a window such as 4:5"},
        "framing_window_y": {"type": ["number", "null"]},
        "caption_style": {"enum": ["keywords", "highlight_all"]},
        "captions_hidden_during": {"type": "array", "items": {"type": "string"}},
        "captions_hidden_ranges": {"type": "array", "items": {"$ref": "#/$defs/range"}},
        "native_caption_track": {"type": "boolean"},
        "caption_size_px": {"type": ["integer", "null"], "minimum": 1, "maximum": 400,
                            "description": "this reel's caption size in px (T4.2; reel-profile/style.json sets the client's; the plan checks 32-140 px on a 1080 px wide frame)"},
        "hook_title_sfx": {"type": ["boolean", "null"], "description": "false: no sound on this reel's hook title (a graphic's own sfx still wins)"},
        "highlight_colour": {"type": ["string", "null"], "pattern": "^ *(brand|accent|ink|#[0-9A-Fa-f]{6}|#[0-9A-Fa-f]{3}) *$",
                             "description": "the keyword caption box: brand | accent | ink | #RRGGBB (contrast-checked)"},
        "remove_pauses": {
          "type": ["object", "boolean", "null"],
          "properties": {
            "min_pause_ms": {"type": "integer", "minimum": 0},
            "pad_ms": {"type": "integer", "minimum": 0},
            "mask_scales": {"type": "array", "items": {"type": "number"}},
            "protect": {"type": "array", "items": {"$ref": "#/$defs/range"}}
          }
        },
        "cut_words": {
          "type": "array",
          "items": {
            "anyOf": [
              {"type": "integer"},
              {"type": "object", "required": ["word_ids"],
               "properties": {"word_ids": {"type": "array", "items": {"type": "integer"}}, "reason": {"type": "string"}}}
            ]
          }
        },
        "photoshop_jobs": {"type": "array", "items": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string"}}}}
      }
    },
    "caption_highlights": {
      "type": "array",
      "items": {"type": "object", "required": ["text"],
                "properties": {"text": {"type": "string", "minLength": 1}, "at": {"anyOf": [{"$ref": "#/$defs/time"}, {"type": "null"}]}}}
    },
    "manual_verse": {
      "type": "array",
      "description": "manual verse: recited-verse spans the plan missed (source time); the plan leaves their captions empty and marks them for the editor, who adds the verse by hand. A detected span this one overlaps is replaced by it. `note` stays in the timeline spec only (never quote the verse in it)",
      "items": {"type": "object", "required": ["start_ms", "end_ms"],
                "properties": {"start_ms": {"$ref": "#/$defs/time"}, "end_ms": {"$ref": "#/$defs/time"},
                               "note": {"type": "string", "maxLength": 300}}}
    },
    "manual_verse_off": {
      "type": "array",
      "description": "manual verse: removes each detected recited-verse span this range overlaps (a hadith after «قال الله تعالى», a paraphrase)",
      "items": {"type": "object", "required": ["start_ms", "end_ms"],
                "properties": {"start_ms": {"$ref": "#/$defs/time"}, "end_ms": {"$ref": "#/$defs/time"}}}
    },
    "manual_verse_release": {
      "type": "array",
      "description": "manual verse: releases each caption run held after a verse that ends on a pause (`verse_hold` in the timeline spec) this range overlaps, once the editor has listened and it is not the verse (source time)",
      "items": {"type": "object", "required": ["start_ms", "end_ms"],
                "properties": {"start_ms": {"$ref": "#/$defs/time"}, "end_ms": {"$ref": "#/$defs/time"}}}
    },
    "music": {
      "type": "object",
      "properties": {
        "status": {"type": "string"},
        "file": {"type": "string", "description": "a licensed track (reel music --list)"},
        "level_db": {"type": "number"},
        "fade_out_s": {"type": "number", "minimum": 0},
        "cue_points": {
          "type": "array",
          "items": {"type": "object",
                    "properties": {"at": {"anyOf": [{"$ref": "#/$defs/time"}, {"type": "null"}]}, "frame": {"type": "integer", "minimum": 0},
                                   "label": {"type": "string"}, "note": {"type": "string"}}}
        }
      }
    },
    "decisions": {"type": "array", "items": {"$ref": "#/$defs/decision"}},
    "asset_needs": {"$ref": "asset-needs.schema.json#/$defs/list"}
  },
  "$defs": {
    "time": {
      "description": "seconds (12.5), an integer of milliseconds, or a clock: 00:00:12.500 / 01:02.5 (same grammar as the engine's parser, media_util.parse_time: surrounding whitespace and Arabic-Indic digits are accepted)",
      "type": ["string", "number"],
      "pattern": "^\\s*(\\d+(\\.\\d+)?|(\\d+:)?\\d+:\\d+([.,]\\d+)?)\\s*$"
    },
    "sfx_kind": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
                 "description": "a procedural sound (whoosh, pop ...) or a kind of the client's 06_audio/sfx-map.json; `reel plan` checks it exists"},
    "range": {"type": "array", "items": {"$ref": "#/$defs/time"}, "minItems": 2, "maxItems": 2},
    "decision": {
      "type": "object",
      "required": ["decision_id", "segment_id", "evidence", "start", "end", "semantic_intent", "visual_treatment",
                   "confidence"],
      "properties": {
        "decision_id": {"type": "string", "minLength": 1, "description": "unique, e.g. EDIT_001"},
        "segment_id": {"type": "string", "minLength": 1},
        "evidence": {"type": "string", "minLength": 1, "description": "the transcript's words, verbatim ('…' joins fragments)"},
        "start": {"$ref": "#/$defs/time"},
        "end": {"$ref": "#/$defs/time"},
        "semantic_intent": {"type": "string", "minLength": 1},
        "visual_treatment": {"type": "string", "minLength": 1},
        "confidence": {"enum": ["high", "medium", "low"]},
        "approval_required": {"type": ["boolean", "null"]},
        "recipe_note": {"type": ["string", "null"]},
        "camera": {
          "type": ["object", "null"],
          "properties": {
            "type": {"enum": ["hold", "punch_in", "punch_out", "slow_push", "reframe"]},
            "at": {"$ref": "#/$defs/time"},
            "until": {"anyOf": [{"$ref": "#/$defs/time"}, {"type": "null"}]},
            "scale_factor": {"type": ["number", "null"]},
            "offset_x": {"type": ["number", "null"]},
            "offset_y": {"type": ["number", "null"]},
            "rationale": {"type": "string"}
          }
        },
        "graphics": {"type": "array", "items": {"$ref": "#/$defs/graphic"}},
        "sound": {
          "type": "array",
          "items": {"type": "object",
                    "properties": {"type": {"$ref": "#/$defs/sfx_kind"}, "at": {"$ref": "#/$defs/time"},
                                   "gain_db": {"type": "number"}, "cue_id": {"type": "string"},
                                   "related_visual": {"type": ["string", "null"]}, "note": {"type": "string"}}}
        }
      }
    },
    "graphic": {
      "type": "object",
      "required": ["id", "template"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "description": "unique, e.g. GFX_001"},
        "template": {"type": "string", "minLength": 1, "description": "a template of graphics-templates.json (the profile may add some)"},
        "start": {"$ref": "#/$defs/time"},
        "end": {"$ref": "#/$defs/time"},
        "text": {"type": "string"},
        "headline": {"type": "string"},
        "items": {"type": "array",
                  "items": {"type": "object", "properties": {"text": {"type": "string"}, "at": {"$ref": "#/$defs/time"},
                                                             "latin": {"type": "boolean"}}}},
        "image": {"type": ["string", "null"]},
        "video": {"type": ["string", "null"]},
        "value": {"type": ["string", "number"]},
        "sfx": {"anyOf": [{"$ref": "#/$defs/sfx_kind"}, {"const": ""}, {"type": "null"}], "description": "a sound kind, or none (null or an empty string: no sound)"},
        "sfx_gain_db": {"type": "number"},
        "latin": {"type": "boolean"},
        "approval_required": {"type": ["boolean", "null"]}
      }
    }
  }
}
