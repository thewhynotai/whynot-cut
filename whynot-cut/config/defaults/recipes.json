      "motion": {"beats": ["setup", "beat", "punchline", "tag"], "scene_s": {"min": 1.5, "target": 3, "max": 6}, "prefer": ["kinetic_quote", "icon_point"], "avoid": ["list_steps"], "reveal": "word", "ease": "bouncy", "transition": "scale", "theme": "brand", "captions": "subtitles", "speaker_badge": true, "progress": false, "voice_pulse": false, "max_words_on_screen": 12, "emphasis_per_scene": 2, "sfx_on_transition": "pop", "sfx_rules": []}
