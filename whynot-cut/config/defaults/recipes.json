      "motion": {"beats": ["moment", "reflection"], "scene_s": {"min": 3.5, "target": 6, "max": 12}, "prefer": ["quote_card", "kinetic_quote"], "avoid": ["list_steps", "stat_counter", "comparison"], "reveal": "line", "ease": "gentle", "transition": "fade", "theme": "dark", "captions": "off", "speaker_badge": true, "progress": false, "voice_pulse": false, "max_words_on_screen": 18, "emphasis_per_scene": 1, "sfx_on_transition": null, "sfx_rules": []}
    },
    "comedy": {
