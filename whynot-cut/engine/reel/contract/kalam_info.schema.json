{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thewhynot.ai/whynot-cut/contract/4/kalam_info.schema.json",
  "title": "kalam_info",
  "description": "RESERVED for Phase 6B (T6.14) \u2014 shape from kalam-prd.md \u00a77.1 kalam_info, FR-2, FR-3; not routed yet. Upstream: adobe/tools/kalam/_upstream/jsx/host.jsx:63 KALAM.info (entry kalam_info :207). CEP WNC_KALAM.info (signed bridge). Contract keys are snake_case; the port translates the upstream camelCase keys (docs/adobe/phase-6b-reservations.md). The active sequence for Kalam's range and audio chips: name, id, fps, end, In/Out, playhead, tracks, selected clips, and the project path (FR-20 writes the SRT next to the project).",
  "$defs": {
    "data": {
      "type": "object",
      "properties": {},
      "additionalProperties": false,
      "description": "No data (the upstream function reads no argument)."
    },
    "readback": {
      "type": "object",
      "properties": {
        "sequence": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "sequence name"
            },
            "id": {
              "type": "string",
              "description": "sequenceID"
            },
            "fps": {
              "type": "number",
              "description": "frame rate (ticks per second / timebase)"
            },
            "end": {
              "type": "number",
              "minimum": 0,
              "description": "sequence end, sequence seconds"
            },
            "in_point": {
              "type": "number",
              "minimum": 0,
              "description": "In point, sequence seconds, as getInPointAsTime reports it (upstream `inPoint`; an unset In is not marked separately)"
            },
            "out_point": {
              "type": "number",
              "minimum": 0,
              "description": "Out point, sequence seconds, as getOutPointAsTime reports it (upstream `outPoint`)"
            },
            "playhead": {
              "type": "number",
              "minimum": 0,
              "description": "playhead, sequence seconds (getPlayerPosition)"
            },
            "video": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "index": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "track index, 0-based"
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "video",
                      "audio"
                    ],
                    "description": "which list it is in"
                  },
                  "name": {
                    "type": "string",
                    "description": "track name"
                  },
                  "clips": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "number of clips on the track (FR-2: tracks with clips are on by default)"
                  },
                  "muted": {
                    "type": "boolean",
                    "description": "the track's mute state (isMuted)"
                  },
                  "locked": {
                    "type": "boolean",
                    "description": "the track's lock state (isLocked); a locked ticked track aborts a cut"
                  }
                },
                "required": [
                  "index",
                  "kind",
                  "name",
                  "clips",
                  "muted",
                  "locked"
                ],
                "description": "One track chip {index,kind,name,clips,muted,locked} (trackInfo). The object stays open: keys the host adds are not rejected."
              },
              "description": "video tracks"
            },
            "audio": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "index": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "track index, 0-based"
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "video",
                      "audio"
                    ],
                    "description": "which list it is in"
                  },
                  "name": {
                    "type": "string",
                    "description": "track name"
                  },
                  "clips": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "number of clips on the track (FR-2: tracks with clips are on by default)"
                  },
                  "muted": {
                    "type": "boolean",
                    "description": "the track's mute state (isMuted)"
                  },
                  "locked": {
                    "type": "boolean",
                    "description": "the track's lock state (isLocked); a locked ticked track aborts a cut"
                  }
                },
                "required": [
                  "index",
                  "kind",
                  "name",
                  "clips",
                  "muted",
                  "locked"
                ],
                "description": "One track chip {index,kind,name,clips,muted,locked} (trackInfo). The object stays open: keys the host adds are not rejected."
              },
              "description": "audio tracks"
            },
            "selection": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "clip name"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "Video",
                      "Audio"
                    ],
                    "description": "Premiere's mediaType, verbatim (other media types are left out)"
                  },
                  "start": {
                    "type": "number",
                    "minimum": 0,
                    "description": "sequence seconds"
                  },
                  "end": {
                    "type": "number",
                    "minimum": 0,
                    "description": "sequence seconds"
                  }
                },
                "required": [
                  "name",
                  "type",
                  "start",
                  "end"
                ],
                "description": "A selected clip (FR-1 / FR-2: the range is their union). The object stays open: keys the host adds are not rejected."
              },
              "description": "selected video / audio clips"
            }
          },
          "required": [
            "name",
            "id",
            "fps",
            "end",
            "in_point",
            "out_point",
            "playhead",
            "video",
            "audio",
            "selection"
          ],
          "description": "The active sequence. The object stays open: keys the host adds are not rejected."
        },
        "project_path": {
          "type": "string",
          "description": "app.project.path (upstream `projectPath`); '' for an unsaved project"
        }
      },
      "required": [
        "sequence",
        "project_path"
      ],
      "description": "{sequence,project_path}. The object stays open: keys the host adds are not rejected."
    }
  }
}
