{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thewhynot.ai/whynot-cut/contract/4/tidy_apply.schema.json",
  "title": "tidy_apply",
  "description": "RESERVED for Phase 6B (T6.13) \u2014 shape from tidy-prd.md \u00a77 tidy_apply, FR-12, FR-16, FR-17, FR-18, \u00a78; not routed yet. Upstream: adobe/tools/tidy/_upstream/jsx/host.jsx:152 TIDY.apply (entry tidy_apply :309). CEP WNC_TIDY.apply (signed bridge). Contract keys are snake_case; the port translates the upstream camelCase keys (docs/adobe/phase-6b-reservations.md). Apply a previewed plan. The host re-checks usage live and keeps a used item or a non-backup sequence even if asked (FR-16; counted in skipped, named in problems). Order (FR-17): moves -> removals (into one temporary bin, then that bin is deleted) -> empty bins by nodeId, only when children.numItems === 0, index rebuilt after each delete -> colours -> nest renames (sequences only); each step fail-safe, failures go to problems. Safety (verbatim, \u00a78): remove from the project only, media files are only ever read; never remove a used item or a non-backup sequence; never delete a bin that holds anything, find bins by nodeId; save + backup copy before applying (tidy_save, then the engine copies the .prproj).",
  "$defs": {
    "data": {
      "type": "object",
      "properties": {
        "removals": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "node_id": {
                "type": "string",
                "minLength": 1,
                "description": "project item nodeId (upstream `nodeId`)"
              },
              "name": {
                "type": "string",
                "description": "item name (upstream does not read it)"
              },
              "checked": {
                "type": "boolean",
                "description": "ticked in the preview; absent = not ticked (upstream skips it)"
              }
            },
            "required": [
              "node_id"
            ],
            "additionalProperties": false,
            "description": "{node_id,name?,checked?}"
          },
          "description": "FR-10, FR-11"
        },
        "moves": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "node_id": {
                "type": "string",
                "minLength": 1,
                "description": "project item nodeId (upstream `nodeId`)"
              },
              "to": {
                "type": "string",
                "minLength": 1,
                "description": "target bin path, e.g. '03 Audio/SFX' (created when missing)"
              }
            },
            "required": [
              "node_id",
              "to"
            ],
            "additionalProperties": false,
            "description": "{node_id,to}"
          },
          "description": "FR-12"
        },
        "empty_bins": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "node_id": {
                "type": "string",
                "minLength": 1,
                "description": "bin nodeId (upstream `nodeId`)"
              },
              "path": {
                "type": "string",
                "description": "bin path, only used in problem messages"
              }
            },
            "required": [
              "node_id"
            ],
            "additionalProperties": false,
            "description": "{node_id,path?}"
          },
          "description": "deepest first (FR-12; upstream `emptyBins`)"
        },
        "colors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "node_id": {
                "type": "string",
                "minLength": 1,
                "description": "project item nodeId (upstream `nodeId`)"
              },
              "color": {
                "type": "integer",
                "minimum": 0,
                "description": "label colour index (setColorLabel)"
              }
            },
            "required": [
              "node_id",
              "color"
            ],
            "additionalProperties": false,
            "description": "{node_id,color}"
          },
          "description": "FR-12"
        },
        "renames": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "node_id": {
                "type": "string",
                "minLength": 1,
                "description": "nest sequence nodeId (upstream `nodeId`)"
              },
              "to": {
                "type": "string",
                "minLength": 1,
                "description": "new nest name (FR-13)"
              },
              "checked": {
                "type": "boolean",
                "description": "ticked in the preview; absent = not ticked"
              }
            },
            "required": [
              "node_id",
              "to"
            ],
            "additionalProperties": false,
            "description": "{node_id,to,checked?}"
          },
          "description": "FR-13"
        }
      },
      "additionalProperties": false,
      "description": "{removals?,moves?,empty_bins?,colors?,renames?}: every list is optional (upstream reads each as `|| []`); FR-18 options leave a list out or empty."
    },
    "readback": {
      "type": "object",
      "properties": {
        "moved": {
          "type": "integer",
          "minimum": 0,
          "description": "items moved"
        },
        "removed": {
          "type": "integer",
          "minimum": 0,
          "description": "items removed"
        },
        "skipped": {
          "type": "integer",
          "minimum": 0,
          "description": "removals refused by the live re-check (FR-16)"
        },
        "bins_removed": {
          "type": "integer",
          "minimum": 0,
          "description": "empty bins deleted (upstream `binsRemoved`)"
        },
        "colored": {
          "type": "integer",
          "minimum": 0,
          "description": "items coloured"
        },
        "renamed": {
          "type": "integer",
          "minimum": 0,
          "description": "nests renamed"
        },
        "problems": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "one plain sentence, e.g. 'kept (in use): <name>'"
          },
          "description": "FR-17: every failed or refused step; the rest continued"
        }
      },
      "required": [
        "moved",
        "removed",
        "skipped",
        "bins_removed",
        "colored",
        "renamed",
        "problems"
      ],
      "description": "{moved,removed,skipped,bins_removed,colored,renamed,problems}. The object stays open: keys the host adds are not rejected."
    }
  }
}
