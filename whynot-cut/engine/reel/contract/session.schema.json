{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thewhynot.ai/whynot-cut/contract/4/session.schema.json",
  "title": "session",
  "description": "Every WebSocket message between the local engine daemon (`reel serve`) and its clients (Premiere UXP panel, After Effects CEP panel, the `reel` CLI). One JSON object per text frame, tagged by `type`. The first client message must be hello. This file validates one message; the daemon runs it before routing anything, then checks command data with the action schema.",
  "$ref": "#/$defs/message",
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9._-]+$",
      "description": "a correlation id: same rule as the v4 request id"
    },
    "connection": {
      "type": "object",
      "description": "ConnectionState",
      "properties": {
        "engine": {
          "type": "string",
          "enum": [
            "connected",
            "offline"
          ]
        },
        "claude": {
          "type": "string",
          "enum": [
            "not_installed",
            "signed_out",
            "plugin_outdated",
            "ready",
            "working",
            "waiting",
            "unknown",
            "active",
            "idle"
          ],
          "description": "the Claude pill (Addendum C1.6, ecosystem.md 3.5c): a local probe of the editor's own Claude CLI and session, never a login WhyNot Cut offers. unknown = not probed yet (the daemon reports it until the T6.2b probe exists). active / idle are the round-1 values: no daemon sends them; they stay only until the panel renderer maps the new states"
        },
        "host": {
          "type": "object",
          "description": "the Adobe host the daemon can reach",
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "uxp",
                "cep",
                "offline"
              ]
            },
            "detail": {
              "type": "string",
              "maxLength": 256,
              "description": "e.g. Premiere Pro 26.5.2"
            },
            "busy": {
              "type": "string",
              "enum": [
                "exporting",
                "rendering",
                "idle",
                "unknown"
              ],
              "description": "G2 H6, read only: is the Adobe host exporting (Premiere: Media Encoder jobs by app.encoder events, or the bridge's own export job) or rendering (After Effects: renderQueue.rendering)? unknown = the bridge cannot vouch for it (no event seen yet, a missed event, an older bridge). Absent = no host, a UXP host (it does not report it yet), or an older daemon"
            }
          },
          "required": [
            "state"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "engine",
        "claude",
        "host"
      ],
      "additionalProperties": false
    },
    "pipeline_step": {
      "type": "object",
      "description": "PipelineStep",
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "transcript",
            "plan",
            "approve",
            "build",
            "frames",
            "qc",
            "handoff"
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "done",
            "running",
            "waiting",
            "pending",
            "failed"
          ]
        },
        "progress": {
          "type": [
            "object",
            "null"
          ],
          "description": "steps done of steps in all, while running",
          "properties": {
            "n": {
              "type": "integer",
              "minimum": 0
            },
            "of": {
              "type": "integer",
              "minimum": 1
            },
            "step": {
              "type": "string",
              "maxLength": 256
            }
          },
          "required": [
            "n",
            "of"
          ],
          "additionalProperties": false
        },
        "phase": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "queued",
            "claimed",
            "running",
            "elapsed",
            null
          ],
          "description": "H2: the running command's last known phase (progress.schema.json phase; `elapsed` ticks keep the phase before them), so the card never says a bare 'running'"
        },
        "host": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "premiere",
            "aftereffects",
            null
          ],
          "description": "H2 review: the host the running command runs in (ae_* actions: aftereffects), so the phase line names it"
        },
        "elapsed_s": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "request_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64,
          "description": "id of the running request; Cancel sends it back"
        }
      },
      "required": [
        "id",
        "state"
      ],
      "additionalProperties": false
    },
    "flagged_item": {
      "type": "object",
      "description": "FlaggedItem",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "medical",
            "religious"
          ]
        },
        "text": {
          "type": "string",
          "maxLength": 2000
        },
        "tc": {
          "type": "string",
          "maxLength": 32,
          "description": "timecode of the statement on the sequence"
        }
      },
      "required": [
        "kind",
        "text",
        "tc"
      ],
      "additionalProperties": false
    },
    "approval": {
      "type": "object",
      "description": "Approval",
      "properties": {
        "summary": {
          "type": "string",
          "maxLength": 20000
        },
        "preview_mp4": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        },
        "flagged": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/flagged_item"
          }
        },
        "fingerprint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "content fingerprint of the plan the editor is looking at; Approve sends it back"
        }
      },
      "required": [
        "summary",
        "preview_mp4",
        "flagged",
        "fingerprint"
      ],
      "additionalProperties": false
    },
    "qc_frame": {
      "type": "object",
      "description": "QcFrame",
      "properties": {
        "t_s": {
          "type": "number"
        },
        "tc": {
          "type": "string",
          "maxLength": 32
        },
        "file": {
          "type": "string",
          "maxLength": 4096
        },
        "label": {
          "type": "string",
          "maxLength": 512
        },
        "verdict": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "pending",
            "media_pending"
          ]
        },
        "w": {
          "type": "number",
          "description": "frame size in pixels; absent or invalid = 1080 x 1920"
        },
        "h": {
          "type": "number"
        },
        "thumb": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096,
          "description": "optional loadable image URL; the shell fills it"
        }
      },
      "required": [
        "t_s",
        "tc",
        "file",
        "label",
        "verdict"
      ],
      "additionalProperties": false
    },
    "log_line": {
      "type": "object",
      "description": "LogLine",
      "properties": {
        "ts": {
          "type": "string",
          "maxLength": 64
        },
        "level": {
          "type": "string",
          "enum": [
            "info",
            "warn",
            "error"
          ]
        },
        "text": {
          "type": "string",
          "maxLength": 4000
        }
      },
      "required": [
        "ts",
        "level",
        "text"
      ],
      "additionalProperties": false
    },
    "item_context": {
      "type": "object",
      "description": "ItemContext: where the current item lives",
      "properties": {
        "project_path": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        },
        "sequence_name": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        },
        "folder": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        },
        "out_dir": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        },
        "review_mp4": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        }
      },
      "required": [
        "project_path",
        "sequence_name",
        "folder",
        "out_dir",
        "review_mp4"
      ],
      "additionalProperties": false
    },
    "job_summary": {
      "type": "object",
      "description": "JobSummary (docs/adobe/eng-data-contract.md 2.6): one command in the daemon's job journal (serve/jobs.py, Addendum G2 H1). A reconnected panel finds its request id here and re-sends the same command: received / queued / claimed = still running (it attaches), done / failed / interrupted = settled (the stored result is replayed; the host never runs it twice). Try again sends a NEW request id only after failed or interrupted. session_kind and job_id stay in the journal file; no data, no host text, no path, no token reach the panel.",
      "properties": {
        "request_id": {
          "$ref": "#/$defs/id"
        },
        "action": {
          "$ref": "request.schema.json#/properties/action"
        },
        "state": {
          "type": "string",
          "enum": [
            "received",
            "queued",
            "claimed",
            "done",
            "failed",
            "interrupted"
          ]
        },
        "submitted_at": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        },
        "item": {
          "type": "string",
          "maxLength": 256,
          "description": "the item the job was for, when the engine knows it"
        },
        "result": {
          "type": "object",
          "description": "the stored result's outcome (done / failed / interrupted only); never the host's text",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "code": {
              "type": "string",
              "enum": [
                "auth",
                "origin",
                "host",
                "too_large",
                "rate",
                "schema",
                "unknown_type",
                "no_route",
                "timeout",
                "internal",
                "interrupted",
                "host_lost"
              ]
            },
            "n": {
              "type": "integer",
              "minimum": 0
            },
            "of": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "ok"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "request_id",
        "action",
        "state",
        "submitted_at",
        "updated_at"
      ],
      "additionalProperties": false
    },
    "panel_state": {
      "type": "object",
      "description": "PanelState: everything the panel shows (adobe/panel-ui/src/source.ts)",
      "properties": {
        "connection": {
          "$ref": "#/$defs/connection"
        },
        "client": {
          "type": "string",
          "maxLength": 256
        },
        "item": {
          "type": "string",
          "maxLength": 256
        },
        "language": {
          "type": "string",
          "enum": [
            "en",
            "ar"
          ]
        },
        "editor_name": {
          "type": "string",
          "maxLength": 256,
          "description": "the editor's name for approvals; empty = the panel asks"
        },
        "context": {
          "$ref": "#/$defs/item_context"
        },
        "pipeline": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/pipeline_step"
          }
        },
        "approval": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/approval"
            }
          ]
        },
        "qc": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/qc_frame"
          }
        },
        "log": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/log_line"
          }
        },
        "jobs": {
          "type": "array",
          "maxItems": 50,
          "description": "the daemon's newest journaled commands (the last 20), newest first; absent from an older daemon",
          "items": {
            "$ref": "#/$defs/job_summary"
          }
        },
        "stale": {
          "type": "boolean",
          "description": "G2 H3: true when this state was built from the last good engine-state read because the fresh read did not answer in time (the first snapshot waits 1 s); the fresh state follows as a push. Absent = fresh."
        }
      },
      "required": [
        "connection",
        "client",
        "item",
        "language",
        "editor_name",
        "context",
        "pipeline",
        "approval",
        "qc",
        "log"
      ],
      "additionalProperties": false
    },
    "hello": {
      "type": "object",
      "description": "client -> daemon, the FIRST message of a connection. The daemon answers welcome or error (auth, schema).",
      "properties": {
        "type": {
          "type": "string",
          "const": "hello"
        },
        "token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "the engine token from <engine home>/bridge/engine.json (256-bit); never sent in a URL"
        },
        "client": {
          "type": "object",
          "description": "who is connecting",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "uxp",
                "cep",
                "cli",
                "panel"
              ]
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "build": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "description": "the panel package's build id (Addendum C1.8): the UTC build time YYYYMMDDTHHMMSSZ (e.g. 20261013T142530Z), the same id the .ccx's build.json `build` carries (premiere-uxp/scripts/build.mjs buildId; release.py writes the shipped ccx's id into <plugin>/adobe/expected.json `build`). The daemon compares it with expected.json and answers welcome.update"
            },
            "host": {
              "type": "string",
              "enum": [
                "premiere",
                "aftereffects"
              ],
              "description": "the Adobe host the client runs in; absent for the CLI"
            },
            "hostVersion": {
              "type": "string",
              "maxLength": 64
            },
            "protocol": {
              "type": "integer",
              "const": 4,
              "description": "contract protocol number"
            },
            "capabilities": {
              "type": "array",
              "maxItems": 35,
              "items": {
                "$ref": "request.schema.json#/properties/action"
              },
              "description": "the actions this client implements; routing uses them"
            }
          },
          "required": [
            "kind",
            "version",
            "protocol",
            "capabilities"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "token",
        "client"
      ],
      "additionalProperties": false
    },
    "welcome": {
      "type": "object",
      "description": "daemon -> client, the answer to an accepted hello. `update.panel` compares the hello's client.build with <plugin>/adobe/expected.json `build` (both the build id YYYYMMDDTHHMMSSZ that build.json carries): ok (the same text), stale (an older id, or two values that differ in any other shape: expected.json is the authority; restart Premiere), newer (a newer id than the plugin's), unknown (no build, no expected.json, or a malformed value: empty, over 64 characters, a control character)",
      "properties": {
        "type": {
          "type": "string",
          "const": "welcome"
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "protocol": {
          "type": "integer",
          "const": 4
        },
        "daemon_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "update": {
          "type": "object",
          "description": "is the connecting panel the build the plugin expects",
          "properties": {
            "panel": {
              "type": "string",
              "enum": [
                "ok",
                "stale",
                "newer",
                "unknown"
              ]
            }
          },
          "required": [
            "panel"
          ],
          "additionalProperties": false
        },
        "features": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "enum": [
              "perf",
              "push"
            ]
          },
          "description": "G2 H3: what this daemon accepts or does beyond protocol 4's core: `perf` = it appends the panel's perf batches; `push` = it pushes a state when the engine state changes (the panel's snapshot poll is then only the fallback). Absent from an older daemon: the panel sends no perf batch."
        }
      },
      "required": [
        "type",
        "session_id",
        "protocol",
        "daemon_version"
      ],
      "additionalProperties": false
    },
    "command": {
      "type": "object",
      "description": "a v4 request. Client -> daemon (CLI or panel run) or daemon -> host client. `request.data` is then checked by the action schema (contract.validate_request).",
      "properties": {
        "type": {
          "type": "string",
          "const": "command"
        },
        "request": {
          "$ref": "request.schema.json"
        },
        "context": {
          "type": "object",
          "description": "where the engine resolves the client from",
          "properties": {
            "root": {
              "type": "string",
              "maxLength": 1024,
              "description": "clients root"
            },
            "profile": {
              "type": "string",
              "maxLength": 256,
              "description": "client profile"
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "request"
      ],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "description": "a v4 result. Host client -> daemon, or daemon -> the client that sent the command.",
      "properties": {
        "type": {
          "type": "string",
          "const": "result"
        },
        "result": {
          "$ref": "result.schema.json"
        }
      },
      "required": [
        "type",
        "result"
      ],
      "additionalProperties": false
    },
    "progress": {
      "type": "object",
      "description": "a v4 progress event for a running command.",
      "properties": {
        "type": {
          "type": "string",
          "const": "progress"
        },
        "progress": {
          "$ref": "progress.schema.json"
        }
      },
      "required": [
        "type",
        "progress"
      ],
      "additionalProperties": false
    },
    "state": {
      "type": "object",
      "description": "daemon -> panel: the panel state, pushed on every change and as the answer to snapshot (`id` echoes it).",
      "properties": {
        "type": {
          "type": "string",
          "const": "state"
        },
        "state": {
          "$ref": "#/$defs/panel_state"
        },
        "id": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "type",
        "state"
      ],
      "additionalProperties": false
    },
    "approve": {
      "type": "object",
      "description": "panel intent (PanelDataSource.approve): `fingerprint` is the approval card's (the current plan's). Answered by a reply.",
      "properties": {
        "type": {
          "type": "string",
          "const": "approve"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "item": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "editor_name": {
          "type": "string",
          "maxLength": 256
        },
        "fingerprint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "type",
        "id",
        "item",
        "editor_name",
        "fingerprint"
      ],
      "additionalProperties": false
    },
    "request_changes": {
      "type": "object",
      "description": "panel intent (PanelDataSource.requestChanges). Answered by a reply.",
      "properties": {
        "type": {
          "type": "string",
          "const": "request_changes"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "item": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "editor_name": {
          "type": "string",
          "maxLength": 256
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        }
      },
      "required": [
        "type",
        "id",
        "item",
        "editor_name",
        "text"
      ],
      "additionalProperties": false
    },
    "rebuild": {
      "type": "object",
      "description": "panel intent (PanelDataSource.rebuild): the engine finds the project from the item (project_path is optional: a panel that sends it keeps working). Answered by a reply.",
      "properties": {
        "type": {
          "type": "string",
          "const": "rebuild"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "item": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "project_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "replace_edited": {
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "id",
        "item",
        "replace_edited"
      ],
      "additionalProperties": false
    },
    "snapshot": {
      "type": "object",
      "description": "panel intent (PanelDataSource.snapshot): asks for a state message.",
      "properties": {
        "type": {
          "type": "string",
          "const": "snapshot"
        },
        "id": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "cancel": {
      "type": "object",
      "description": "panel intent (PanelDataSource.cancel): `id` is the id of the running request to cancel. The cancelled command's own result answers it.",
      "properties": {
        "type": {
          "type": "string",
          "const": "cancel"
        },
        "id": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "additionalProperties": false
    },
    "reply": {
      "type": "object",
      "description": "daemon -> panel: the answer to approve / request_changes / rebuild (the panel's Result type). ok:true carries no error; ok:false requires one.",
      "properties": {
        "type": {
          "type": "string",
          "const": "reply"
        },
        "id": {
          "$ref": "#/$defs/id",
          "description": "the id of the intent this answers"
        },
        "intent": {
          "type": "string",
          "enum": [
            "approve",
            "request_changes",
            "rebuild"
          ]
        },
        "ok": {
          "type": "boolean"
        },
        "readback": {
          "type": "object"
        },
        "error": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "description": "what went wrong, one plain sentence"
        },
        "how": {
          "type": "string",
          "maxLength": 2000,
          "description": "what to do about it"
        }
      },
      "required": [
        "type",
        "id",
        "intent",
        "ok"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "properties": {
            "ok": {
              "const": true
            },
            "error": false
          }
        },
        {
          "properties": {
            "ok": {
              "const": false
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    },
    "error": {
      "type": "object",
      "description": "daemon -> client: a refusal or failure that is not a command result. `id` is the offending message's id when it had one.",
      "properties": {
        "type": {
          "type": "string",
          "const": "error"
        },
        "code": {
          "type": "string",
          "enum": [
            "auth",
            "origin",
            "host",
            "too_large",
            "rate",
            "schema",
            "unknown_type",
            "no_route",
            "timeout",
            "internal"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "id": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "type",
        "code",
        "message"
      ],
      "additionalProperties": false
    },
    "perf_mark": {
      "type": "object",
      "description": "one panel perf mark (G2 H3, budgets S1 first usable state and S2 click -> paint): what happened and when, nothing else. serve/perf.py appends it to <home>/logs/perf.jsonl; a token, a path or a name has no place to go.",
      "properties": {
        "mark": {
          "type": "string",
          "enum": [
            "panel.boot",
            "panel.first_paint",
            "link.welcome",
            "link.first_state",
            "panel.usable",
            "ui.click",
            "ui.paint"
          ],
          "description": "the panel's marks only (the serve marks cmd.* and link.welcome_sent are the daemon's own)"
        },
        "t": {
          "type": "number",
          "minimum": 0,
          "maximum": 100000000000000,
          "description": "when, in epoch milliseconds (the panel's clock)"
        },
        "ms": {
          "type": "number",
          "minimum": 0,
          "maximum": 3600000,
          "description": "the duration this mark closes: since panel.boot for the boot marks, since its ui.click for ui.paint"
        },
        "rid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "description": "pairs a ui.click with its ui.paint (e.g. c-12); never a request token or a path"
        }
      },
      "required": [
        "mark",
        "t"
      ],
      "additionalProperties": false
    },
    "perf": {
      "type": "object",
      "description": "panel -> daemon (G2 H3): a batch of perf marks, sent only to a daemon whose welcome lists `perf`. The daemon appends it (panel sessions only, rate-limited per session, an over-the-rate batch is dropped silently) and answers nothing.",
      "properties": {
        "type": {
          "type": "string",
          "const": "perf"
        },
        "marks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/perf_mark"
          }
        }
      },
      "required": [
        "type",
        "marks"
      ],
      "additionalProperties": false
    },
    "message": {
      "description": "any session message: exactly one of the closed, `type`-tagged objects above",
      "oneOf": [
        {
          "$ref": "#/$defs/hello"
        },
        {
          "$ref": "#/$defs/welcome"
        },
        {
          "$ref": "#/$defs/command"
        },
        {
          "$ref": "#/$defs/result"
        },
        {
          "$ref": "#/$defs/progress"
        },
        {
          "$ref": "#/$defs/state"
        },
        {
          "$ref": "#/$defs/approve"
        },
        {
          "$ref": "#/$defs/request_changes"
        },
        {
          "$ref": "#/$defs/rebuild"
        },
        {
          "$ref": "#/$defs/snapshot"
        },
        {
          "$ref": "#/$defs/cancel"
        },
        {
          "$ref": "#/$defs/reply"
        },
        {
          "$ref": "#/$defs/error"
        },
        {
          "$ref": "#/$defs/perf"
        }
      ]
    }
  }
}
