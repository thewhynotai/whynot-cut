#!/usr/bin/env bash
# WhyNot Cut engine wrapper (macOS, Linux, and Git Bash on Windows). The plugin's bin/ is on PATH while it is enabled.
# Machine state lives in the engine home (default ~/.whynot-cut), never inside the plugin folder.
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Engine home, the same order as plat.engine_home(): env > the saved plugin option (the pointer file the SessionStart
# hook writes; without one, Claude Code's settings.json pluginConfigs) > ~/.whynot-cut with an engine (a runtime
# `current` file or venv/) > a legacy home
# (.reel-editor / .dr-nahla-editor: still read in 3.x, dropped in 4.0) > ~/.whynot-cut. Pure bash: no forks.
# The validity and entry rules match plat.saved_options() (its docstring lists the remaining edge cases).
bs='\' q='"' str_re='"(([^"\\]|\\.)*)"'
json_path() {   # $1 = a JSON string body -> $HOME_DIR (the escapes a path can hold: \\ and \")
  local v="$1"
  v=${v//"$bs$bs"/$bs}
  HOME_DIR=${v//"$bs$q"/$q}
}
pointer_engine_home() {   # $1 = pointer file, any layout. Valid: an "engine_home" string and the closing brace.
  local s='' key_re="\"engine_home\"[[:space:]]*:[[:space:]]*$str_re" end_re='[}][[:space:]]*$'
  [ -r "$1" ] || return 1
  IFS= read -r -d '' s < "$1" || true
  [[ $s =~ $end_re ]] || return 1
  [[ $s =~ $key_re ]] || return 1
  json_path "${BASH_REMATCH[1]}"
}
settings_engine_home() {   # $1 = settings.json, one key per line as Claude Code writes it. pluginConfigs entry
  # whynot-cut@thewhynot-ai when it has "options", else the first other whynot-cut@* entry that has them.
  local line blk='' seen_id='' seen_any='' got_id='' got_any='' val_id='' val_any='' \
        key_re="^[[:space:]]*\"engine_home\"[[:space:]]*:[[:space:]]*$str_re" \
        obj_re='^[[:space:]]*"([^"]*)"[[:space:]]*:[[:space:]]*[{]'
  [ -r "$1" ] || return 0
  while IFS= read -r line || [ -n "$line" ]; do
    if [[ $line =~ $obj_re ]]; then
      case "${BASH_REMATCH[1]}" in
        options) if [ "$blk" = id ]; then seen_id=1; elif [ "$blk" = any ]; then seen_any=1; fi ;;
        whynot-cut@thewhynot-ai) blk=id ;;
        whynot-cut@*) if [ -z "$seen_any" ]; then blk=any; else blk=''; fi ;;
        *) blk='' ;;
      esac
    elif [[ $line =~ $key_re ]]; then
      if [ "$blk" = id ] && [ -n "$seen_id" ] && [ -z "$got_id" ]; then val_id="${BASH_REMATCH[1]}"; got_id=1; fi
      if [ "$blk" = any ] && [ -n "$seen_any" ] && [ -z "$got_any" ]; then val_any="${BASH_REMATCH[1]}"; got_any=1; fi
    fi
  done < "$1"
  if [ -n "$seen_id" ]; then json_path "$val_id"; elif [ -n "$seen_any" ]; then json_path "$val_any"; fi
  return 0
}
HOME_DIR="${WHYNOT_HOME:-${CLAUDE_PLUGIN_OPTION_ENGINE_HOME:-${REEL_HOME:-${CLAUDE_PLUGIN_OPTION_REEL_HOME:-}}}}"
if [ -z "$HOME_DIR" ]; then
  if ! pointer_engine_home "${WHYNOT_OPTIONS_FILE:-$HOME/.whynot-cut/plugin-options.json}"; then
    settings_engine_home "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/settings.json"
  fi
  case "$HOME_DIR" in "~"|"~/"*|"~\\"*) HOME_DIR="$HOME${HOME_DIR:1}" ;; esac
fi
if [ -z "$HOME_DIR" ]; then
  HOME_DIR="$HOME/.whynot-cut"
  if [ ! -d "$HOME_DIR/venv" ] && [ ! -f "$HOME_DIR/current" ]; then   # it may only hold the pointer file
    for old in .reel-editor .dr-nahla-editor; do
      if [ -d "$HOME/$old/venv" ]; then HOME_DIR="$HOME/$old"; break; fi
    done
  fi
fi
export WHYNOT_HOME="$HOME_DIR"
tag() {   # "WhyNot Cut 2.2.0": every blocked message names this plugin, so a wrong `reel` on PATH is recognisable
  local v; v="$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$HERE/.claude-plugin/plugin.json" 2>/dev/null | head -n 1 || true)"
  echo "WhyNot Cut ${v:-?}"
}
# The engine interpreter (3.0 T2.1, same order as plat.engine_runtime()): the isolated runtime named by the one-line
# text file <home>/current (runtimes/<id>/, run with -s: no user site), else the 2.x venv/ (run as before: a venv
# built with --system-site-packages may rely on the user site). Never a system Python for the engine.
PY='' PYFLAG='' RID_RE='^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$'
find_py() {
  local id='' c
  if [ -f "$HOME_DIR/current" ]; then
    IFS= read -r id < "$HOME_DIR/current" || true
    id="${id#$'\xef\xbb\xbf'}"
    id="${id//[[:space:]]/}"
    [[ $id =~ $RID_RE ]] && [[ $id != *..* ]] || id=''      # the id rule of lib/plat.py
    if [ -n "$id" ]; then
      for c in "$HOME_DIR/runtimes/$id/bin/python" "$HOME_DIR/runtimes/$id/Scripts/python.exe"; do
        if [ -x "$c" ]; then PY="$c"; PYFLAG=-s; return 0; fi
      done
    fi
  fi
  for c in "$HOME_DIR/venv/bin/python" "$HOME_DIR/venv/Scripts/python.exe"; do
    if [ -x "$c" ]; then PY="$c"; PYFLAG=''; return 0; fi
  done
  return 1
}
if ! find_py; then
  if [ "${1:-}" = "setup" ]; then
    echo "WhyNot Cut: no engine yet — creating it in $HOME_DIR (a few minutes, ~400 MB)…" >&2
    for sys_py in python3 python py; do
      if command -v "$sys_py" >/dev/null 2>&1 && "$sys_py" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 9) else 1)' </dev/null >/dev/null 2>&1; then
        "$sys_py" "$HERE/setup/setup_env.py" --home "$HOME_DIR" >&2 || true
        ran=1
        break
      fi
    done
    if ! find_py; then
      if [ -n "${ran:-}" ]; then
        echo "{\"blocked\": \"$(tag): building the engine runtime failed (its report is above)\", \"how\": \"check the internet connection, then run: reel setup\"}"
        exit 2
      fi
      echo "{\"blocked\": \"$(tag): no Python 3.9+ found to build the engine\", \"how\": \"macOS: xcode-select --install (or python.org). Windows: winget install Python.Python.3.12  — then run: reel setup\"}"
      exit 2
    fi
  else
    echo "{\"blocked\": \"$(tag): engine not installed\", \"how\": \"run: reel setup   (or /whynot-cut:start)\"}"
    exit 2
  fi
fi
export PYTHONDONTWRITEBYTECODE=1 PYTHONUTF8=1 PYTHONIOENCODING=utf-8   # no __pycache__ in the plugin; UTF-8 on Windows
exec "$PY" $PYFLAG "$HERE/engine/reel/cli.py" "$@"
