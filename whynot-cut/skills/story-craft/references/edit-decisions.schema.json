{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "edit-decisions.json (authored by Claude, compiled by `reel plan`)",
  "type": "object",
  "required": [
    "video_id",
    "global",
    "decisions"
  ],
  "properties": {
    "video_id": {
      "type": "string"
    },
    "version": {
      "type": "integer"
    },
    "global": {
      "type": "object",
      "required": [
        "main_footage"
      ],
      "properties": {
        "main_footage": {
          "type": "string"
        },
        "base_scale_percent": {
          "type": "number"
        },
        "caption_style": {
          "enum": [
            "keywords",
            "highlight_all"
          ]
        },
        "captions_hidden_during": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "photoshop_jobs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ]
          }
        },
        "remove_pauses": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "min_pause_ms": {
              "type": "integer"
            },
            "pad_ms": {
              "type": "integer"
            },
            "mask_scales": {
              "type": "array",
              "items": {
                "type": "number"
              }
            }
          }
        },
        "native_caption_track": {
          "type": "boolean"
        },
        "captions_hidden_ranges": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": [
                "string",
                "number"
              ]
            },
            "minItems": 2,
            "maxItems": 2
          }
        }
      }
    },
    "caption_highlights": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "text"
        ]
      }
    },
    "music": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "NO_MUSIC_SUPPLIED",
            "PLACED"
          ]
        },
        "cue_points": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "frame"
            ]
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "decision_id",
          "segment_id",
          "evidence",
          "start",
          "end",
          "semantic_intent",
          "visual_treatment",
          "confidence"
        ],
        "properties": {
          "decision_id": {
            "type": "string",
            "pattern": "^EDIT_[0-9]{3}$"
          },
          "segment_id": {
            "type": "string"
          },
          "evidence": {
            "type": "string",
            "minLength": 2
          },
          "start": {
            "type": [
              "string",
              "number"
            ]
          },
          "end": {
            "type": [
              "string",
              "number"
            ]
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "approval_required": {
            "type": "boolean"
          },
          "camera": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "hold",
                  "punch_in",
                  "punch_out",
                  "slow_push",
                  "reframe"
                ]
              },
              "scale_factor": {
                "type": "number",
                "minimum": 0.8,
                "maximum": 1.5
              }
            }
          },
          "graphics": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "template"
              ],
              "properties": {
                "template": {
                  "enum": [
                    "highlight_caption",
                    "hook_title",
                    "term_callout",
                    "glass_card",
                    "checklist",
                    "broll_card",
                    "photo_card",
                    "name_card",
                    "cta",
                    "logo_outro",
                    "flash_transition",
                    "statement_highlight"
                  ]
                }
              }
            }
          },
          "sound": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "enum": [
                    "whoosh",
                    "whoosh_soft",
                    "pop",
                    "click",
                    "tick",
                    "riser_soft",
                    "hit_soft",
                    "shimmer"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
