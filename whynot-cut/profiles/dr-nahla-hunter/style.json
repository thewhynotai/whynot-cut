{
  "note": "Editor's standing style decisions. The story-editor copies these into edit-decisions.json global/decisions; the engine does not apply them silently.",
  "remove_pauses": {
    "min_pause_ms": 250,
    "pad_ms": 80,
    "mask_scales": [
      1.0,
      1.06
    ]
  },
  "native_caption_track": false,
  "captions_hidden_during": [
    "broll_card",
    "statement_highlight",
    "checklist",
    "term_callout",
    "hook_title",
    "logo_outro"
  ],
  "statement_template": "statement_highlight",
  "glass_only_on": [
    "name_card"
  ],
  "caption_style": "keywords",
  "animation": {
    "bars": "bar_sweep (Crop Left 100->0, RTL)",
    "text": "text_pop",
    "checklist_items": "slide",
    "broll": "push"
  }
}
